rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Installations: Public Read, Admin Write
    match /installations/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'yankele13@gmail.com';
    }
    
    // Default block
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
